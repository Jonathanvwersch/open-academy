{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.venv",
      "!**/dist-vercel",
      "!.ample",
      "!.vercel",
      "!playwright-report",
      "!test-results",
      "!tests/e2e/.auth",
      "!docs",
      "!apps/api/drizzle/meta",
      "!apps/api/src/features/tutor/prompts",
      "!apps/web/src/components/ui",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/aesop/src/cli/template/.agents"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
