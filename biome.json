{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.ample",
      "!dist",
      "!playwright-report",
      "!test-results",
      "!tests/e2e/.auth",
      "!docs",
      "!drizzle/meta",
      "!src/server/tutor/prompts",
      "!src/web/ui",
      "!src/web/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
