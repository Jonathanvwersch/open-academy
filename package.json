{
  "name": "academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && node scripts/install-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @academy/api dev",
    "dev:web": "pnpm --filter @academy/web dev",
    "db:generate": "pnpm --filter @academy/api db:generate",
    "db:migrate": "pnpm --filter @academy/api db:migrate",
    "db:seed": "pnpm --filter @academy/api db:seed",
    "db:reset": "pnpm --filter @academy/api db:reset",
    "content:check": "pnpm --filter @academy/api content:check",
    "test": "docker compose up -d && node scripts/wait-for-db.mjs && vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "test:architecture": "node --test scripts/architecture/check.test.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "boundaries": "node scripts/architecture/check.mjs",
    "check": "pnpm boundaries && pnpm lint && pnpm typecheck && pnpm content:check && pnpm test:architecture",
    "build": "pnpm --filter @academy/web build && pnpm --filter @academy/api build",
    "start": "pnpm --filter @academy/api start",
    "vercel-build": "pnpm build && pnpm --filter @academy/api vercel:bundle && pnpm --filter @academy/api vercel:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxc-parser": "0.151.0",
    "oxc-resolver": "11.24.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "tsx": "4.23.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@academy/shared": "workspace:*"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "mathjs": "15.2.0",
    "openai": "7.47.0",
    "pdfjs-dist": "6.3.289",
    "postgres": "4.0.0",
    "ts-fsrs": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
