{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "supportsCancellation": true,
      "includeFiles": "{content/**,apps/api/dist-vercel/content.bin,apps/api/dist-vercel/prompts/**,apps/api/drizzle/**,node_modules/.pnpm/pdfjs-dist@*/node_modules/pdfjs-dist/standard_fonts/**}"
    }
  },
  "git": {
    "deploymentEnabled": {
      "devin/**": false,
      "fix/**": false
    }
  }
}
