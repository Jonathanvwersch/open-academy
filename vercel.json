{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/web",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{content/**,src/server/tutor/prompts/**,drizzle/**,node_modules/.pnpm/pdfjs-dist@*/node_modules/pdfjs-dist/standard_fonts/**}"
    }
  }
}
