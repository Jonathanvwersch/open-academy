# Application database; docker-compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgres://academy:academy@localhost:5433/academy

# Isolated database used by Vitest.
TEST_DATABASE_URL=postgres://academy:academy@localhost:5433/academy_test

# API server port.
PORT=3001

# Optional single-user login password; production requires at least 12 characters.
ACADEMY_PASSWORD=

# Public demo mode; leave ACADEMY_PASSWORD unset when enabled.
ACADEMY_DEMO=0
ACADEMY_DEMO_TTL_HOURS=24

# Optional OpenAI tutor. Keep the key only in your local environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
TUTOR_DAILY_CALL_CAP=200
