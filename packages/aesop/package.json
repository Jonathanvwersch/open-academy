    "./store/*": "./src/store/*.ts"
  },
  "dependencies": {
    "@academy/contracts": "workspace:*",
    "mathjs": "15.2.0",
    "ts-fsrs": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
