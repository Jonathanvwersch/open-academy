{
  "name": "@open-academy/engine",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "HOW-IT-WORKS.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "academy": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'),path=require('node:path');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('src/cli/template','dist/cli/template',{recursive:true});for(const file of ['.agents/skills/write-lesson/SKILL.md','.agents/skills/write-questions/SKILL.md','.agents/skills/set-weights/SKILL.md','content/lessons/gradient-descent.yaml','content/exercises/gradient-descent.yaml','docs/CONTENT_FORMAT.md','docs/design/lesson-standard.md']){const dest=path.join('dist/cli/template',file);fs.mkdirSync(path.dirname(dest),{recursive:true});fs.copyFileSync(path.join('../..',file),dest)}\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    "./api/*": "./src/api/*.ts",
    "./course/*": "./src/course/*.ts",
    "./engine/*": "./src/engine/*.ts",
    "./graph/*": "./src/graph/*.ts",
    "./memory/*": "./src/memory/*.ts",
    "./planner/*": "./src/planner/*.ts",
    "./lessons/*": "./src/lessons/*.ts",
    "./lessons/grading/*": "./src/lessons/grading/*.ts",
    "./placement/*": "./src/placement/*.ts",
    "./progress/*": "./src/progress/*.ts",
    "./store/*": "./src/store/*.ts",
    "./quizzes/*": "./src/quizzes/*.ts",
    "./simulator/*": "./src/simulator/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": "./dist/*.js"
    }
  },
  "dependencies": {
    "mathjs": "15.2.0",
    "ts-fsrs": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
