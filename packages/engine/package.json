{
  "name": "@open-academy/engine",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "HOW-IT-WORKS.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "academy": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./node": "./src/node.ts",
    "./simulator": "./src/simulator/index.ts",
    "./testing": "./src/testing.ts",
    "./internal/*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./api": {
        "types": "./dist/api/index.d.ts",
        "import": "./dist/api/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "./simulator": {
        "types": "./dist/simulator/index.d.ts",
        "import": "./dist/simulator/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "dependencies": {
    "mathjs": "15.2.0",
    "ts-fsrs": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "vitest": "5.1.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
